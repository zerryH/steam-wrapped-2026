STEAM_API_KEY=put_your_steam_web_api_key_here
# 17-digit SteamID64 or your Steam vanity profile name
STEAM_ID=put_your_steam_id_here

WRAPPED_YEAR=2026
DEEP_STATS_LIMIT=40
# 200 = scan the 200 most-played games; -1 = scan every detected game
ACHIEVEMENT_SCAN_LIMIT=200

# Optional: auto-detected on common Windows/macOS/Linux installations.
# Set this if Steam is installed in a non-standard location.
# STEAM_LOG_DIR=C:\Program Files (x86)\Steam\logs

# Optional public ThunderSkill nickname (not your password).
# THUNDERSKILL_NICKNAME=YourWarThunderNickname
